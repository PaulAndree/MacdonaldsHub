{
  "name": "delivery-hub-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contract:lint": "redocly lint ../../docs/api/openapi.yaml --config ../../docs/api/redocly.yaml",
    "contract:generate": "node scripts/contract.mjs generate",
    "contract:check": "node scripts/contract.mjs check",
    "approval:hash": "node scripts/approval.mjs hash",
    "approval:check": "node scripts/approval.mjs check",
    "check:contrast": "node scripts/contrast.mjs",
    "build:example": "tsc --noEmit && vite build --mode example-data",
    "dev:example": "vite --mode example-data",
    "check:bundle:standard": "node scripts/check-bundle.mjs standard dist",
    "check:bundle:example": "node scripts/check-bundle.mjs example dist"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tanstack/react-query": "^5.108.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@redocly/cli": "^2.82.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "vitest-axe": "^0.1.0",
    "yaml": "^2.9.1"
  }
}
