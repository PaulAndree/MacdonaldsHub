# Copy to .env (never commit .env). Names are UPPER_SNAKE_CASE, no spaces around "=".
# `docker compose up` works without a .env; these override its throwaway local defaults.
# In Azure, secrets come from Key Vault, never from files.

# --- Environment and adapters (configuration selects adapters, never business rules) ---
APP_ENV=local                      # local | test | production
IDENTITY_PROVIDER=dev              # dev (APP_ENV=local only) | easy_auth (Azure only)
STORAGE_BACKEND=azurite            # azurite | azure_blob
MAIL_TRANSPORT=smtp_capture        # smtp_capture | smtp
TELEMETRY_EXPORTER=console         # console | azure_monitor

# --- Local development identity (IDENTITY_PROVIDER=dev) ---
DEV_IDENTITY_EMAIL=
DEV_IDENTITY_ROLE=administrator    # administrator | global_manager

# --- Identity in Azure (IDENTITY_PROVIDER=easy_auth) ---
ALLOWLIST_IDENTIFIER=              # sub | email  (decision P-07, no default)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_SUBJECT=
GOOGLE_AUTH_ACCOUNT=

# --- Data stores ---
POSTGRES_PASSWORD=
DATABASE_URL=
STORAGE_CONNECTION_STRING=         # Azurite only
STORAGE_PUBLIC_ENDPOINT=           # browser-facing blob URL when it differs from the internal one
STORAGE_ACCOUNT_URL=               # Azure Blob (managed identity)
FRONTEND_ORIGIN=

# --- Imports (change 2) ---
IMPORTS_ENABLED=false              # true needs the branch catalog below, or startup is refused
BRANCH_CATALOG=                    # comma-separated branch names from the administrator (P-01), no default

# --- Mail (sending is implemented in a later change) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEST_RECIPIENT_EMAIL=

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Other ---
AZURE_ACCOUNT=
